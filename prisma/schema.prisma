generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  admin
  tech
  client
}

enum TechStatus {
  available
  on_site    @map("on-site")
  in_transit @map("in-transit")
}

enum JobType {
  installation
  maintenance
  repair
  sales
  inspection
  callout
}

enum JobStatus {
  scheduled
  in_progress     @map("in-progress")
  on_site         @map("on-site")
  completed
  cancelled
  pending_parts   @map("pending-parts")
  unallocated
  pending_booking @map("pending-booking")
}

enum JobPriority {
  urgent
  high
  medium
  low
}

enum IssueType {
  install
  repair
  service
  quote
}

enum UnitType {
  Split_System         @map("Split System")
  Ducted
  Package_Unit         @map("Package Unit")
  Multi_Head           @map("Multi-Head")
  Cassette
  VRV_VRF              @map("VRV/VRF")
  Refrigeration_System @map("Refrigeration System")
  Chiller
  Heat_Pump            @map("Heat Pump")
  Precision_Cooling    @map("Precision Cooling")
}

enum RefrigerantType {
  R_32   @map("R-32")
  R_410A @map("R-410A")
  R_22   @map("R-22")
  R_134a @map("R-134a")
  R_407C @map("R-407C")
  R_600A @map("R-600A")
  R_290  @map("R-290")
}

enum SystemStatus {
  optimal
  sub_optimal @map("sub-optimal")
  critical
}

enum AlertType {
  HIGH_CURRENT
  LOW_VOLTAGE
  HIGH_TEMP
  PRESSURE_LEAK
}

enum JobSource {
  admin
  portal
}

enum CRMType {
  call
  visit
  complaint
  email
  quote
}

enum CRMOutcome {
  positive
  negative
  pending
  resolved
}

enum ConsumableType {
  gas
  compressor
  part
  other
}

enum AuditAction {
  login
  view_job
  edit_job
  complete_job
  delete_job
  adjust_stock
  create_customer
  update_customer
  delete_customer
  create_gas_stock
  update_gas_stock
  delete_gas_stock
  create_consumable
  delete_consumable
  create_user
  update_user
  delete_user
  allocate_fund
  update_fund
  close_fund
  record_expense
  update_expense
  delete_expense
}

enum EmailDeliveryStatus {
  sent
  failed
  skipped
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
}

// ============================================
// AUTH MODELS (NextAuth.js)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// USER MODEL
// ============================================

model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  emailVerified   DateTime?   @map("email_verified")
  role            UserRole
  password        String // Hashed password (replaces pin)
  passwordChanged Boolean     @default(false) @map("password_changed") // Track if user changed temp password
  phone           String?
  specialty       String?
  status          TechStatus?
  image           String? // Avatar URL
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Auth relations
  accounts Account[]
  sessions Session[]

  // App relations
  assignedJobs        Job[]            @relation("AssignedJobs")
  coAssignedJobs      Job[]            @relation("CoAssignedJobs")
  gasUsageRecords     GasUsageRecord[] @relation("GasUsageByUser")
  crmRecords          CRMRecord[]
  consumables         Consumable[]     @relation("ConsumableRecordedBy")
  auditLogs           AuditLog[]       @relation("AuditLogByUser")
  uploadedAttachments JobAttachment[]  @relation("JobAttachmentUploadedBy")

  // Fund management
  fundAllocationsReceived FundAllocation[] @relation("FundsAllocatedTo")
  fundAllocationsCreated  FundAllocation[] @relation("FundsCreatedBy")
  fundExpensesRecorded    FundExpense[]    @relation("FundExpenseRecordedBy")

  @@map("users")
}

// ============================================
// CORE APP MODELS
// ============================================

model Customer {
  id            String   @id @default(cuid())
  name          String
  address       String
  siteAddress   String?  @map("site_address")
  phone         String
  whatsapp      String?
  email         String   @unique
  portalCode    String?  @unique @map("portal_code")
  portalEnabled Boolean  @default(false) @map("portal_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  jobs       Job[]
  crmRecords CRMRecord[]
  invoices   Invoice[]
  quotes     Quote[]

  @@map("customers")
}

model Job {
  id          String      @id @default(cuid())
  source      JobSource
  customerId  String      @map("customer_id")
  title       String
  type        JobType
  unitType    UnitType    @map("unit_type")
  issue       IssueType
  priority    JobPriority
  date        String
  time        String
  status      JobStatus
  clockIn     String?     @map("clock_in")
  clockOut    String?     @map("clock_out")
  description String
  photos      String[]
  signature   String?
  jobCardRef  String      @unique @map("job_card_ref")
  alerts      AlertType[]
  version     Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  technicians   User[] @relation("AssignedJobs")
  coTechnicians User[] @relation("CoAssignedJobs")

  diagnostics     Diagnostics?
  comments        Comment[]
  history         HistoryEntry[]
  recurring       RecurringSchedule?
  gasUsageRecords GasUsageRecord[]   @relation("GasUsageOfJob")
  consumables     Consumable[]       @relation("ConsumableOfJob")
  auditLogs       AuditLog[]         @relation("AuditLogOfJob")
  attachments     JobAttachment[]    @relation("JobAttachmentOfJob")
  invoices        Invoice[]
  fundExpenses    FundExpense[]

  @@map("jobs")
}

model Diagnostics {
  id                   String           @id @default(cuid())
  jobId                String           @unique @map("job_id")
  voltage              String?
  current              String?
  avgTemp              String?          @map("avg_temp")
  maxTemp              String?          @map("max_temp")
  suction              String?
  discharge            String?
  refrigerantType      RefrigerantType? @map("refrigerant_type")
  refrigerantRecovered Float?           @map("refrigerant_recovered")
  refrigerantUsed      Float?           @map("refrigerant_used")
  refrigerantReused    Float?           @map("refrigerant_reused")
  status               SystemStatus?
  notes                String?
  deltaT               String?          @map("delta_t")
  brand                String?
  serial               String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("diagnostics")
}

model Comment {
  id        String   @id @default(cuid())
  jobId     String   @map("job_id")
  author    String
  text      String
  time      String
  createdAt DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model HistoryEntry {
  id        String   @id @default(cuid())
  jobId     String   @map("job_id")
  date      String
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("history_entries")
}

model RecurringSchedule {
  id       String @id @default(cuid())
  jobId    String @unique @map("job_id")
  interval Int
  unit     String @default("months")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("recurring_schedules")
}

model GasStockItem {
  id          String   @id @default(cuid())
  gasType     String   @map("gas_type")
  brand       String
  quantity    Float
  remaining   Float
  unit        String
  supplier    String
  supplierRef String   @map("supplier_ref")
  addedBy     String   @map("added_by")
  date        String
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  usageRecords GasUsageRecord[] @relation("GasUsageRecords")
  // CHECK constraints added via migration
  // @@check([remaining >= 0])
  // @@check([quantity >= 0])

  @@map("gas_stock")
}

model GasUsageRecord {
  id           String   @id @default(cuid())
  stockId      String?  @map("stock_id")
  gasType      String   @map("gas_type")
  quantityUsed Float    @map("quantity_used")
  usedBy       String?  @map("used_by")
  jobId        String?  @map("job_id")
  customer     String
  date         String
  time         String
  purpose      String
  createdAt    DateTime @default(now()) @map("created_at")

  stockItem GasStockItem? @relation("GasUsageRecords", fields: [stockId], references: [id], onDelete: SetNull)
  user      User?         @relation("GasUsageByUser", fields: [usedBy], references: [id], onDelete: SetNull)
  job       Job?          @relation("GasUsageOfJob", fields: [jobId], references: [id], onDelete: SetNull)

  // CHECK constraints added via migration
  // @@check([quantityUsed >= 0])
  @@index([jobId])
  @@index([stockId])
  @@index([usedBy])
  @@map("gas_usage")
}

model CRMRecord {
  id           String     @id @default(cuid())
  customerId   String     @map("customer_id")
  type         CRMType
  subject      String
  body         String
  date         String
  time         String
  by           String
  followUp     String?    @map("follow_up")
  followUpDone Boolean    @default(false) @map("follow_up_done")
  outcome      CRMOutcome
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [by], references: [id], onDelete: Cascade)

  @@map("crm_records")
}

model Consumable {
  id         String         @id @default(cuid())
  jobId      String?        @map("job_id")
  type       ConsumableType
  name       String
  brand      String?
  model      String?
  quantity   Float
  unit       String
  notes      String?
  recordedBy String?        @map("recorded_by")
  recordedAt DateTime       @default(now()) @map("recorded_at")

  job  Job?  @relation("ConsumableOfJob", fields: [jobId], references: [id], onDelete: SetNull)
  user User? @relation("ConsumableRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)
  // @@check([quantity >= 0])

  @@index([jobId])
  @@index([recordedBy])
  @@map("consumables")
}

model JobAttachment {
  id          String   @id @default(cuid())
  jobId       String   @map("job_id")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  size        Int?
  dataUrl     String?  @map("data_url") @db.Text
  url         String?  @db.Text
  note        String?
  uploadedBy  String?  @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  job  Job   @relation("JobAttachmentOfJob", fields: [jobId], references: [id], onDelete: Cascade)
  user User? @relation("JobAttachmentUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([jobId, uploadedAt])
  @@index([uploadedBy])
  @@map("job_attachments")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?     @map("user_id")
  userName  String      @map("user_name")
  action    AuditAction
  jobId     String?     @map("job_id")
  latitude  Float?
  longitude Float?
  accuracy  Float?
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  reason    String?
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation("AuditLogByUser", fields: [userId], references: [id], onDelete: SetNull)
  job  Job?  @relation("AuditLogOfJob", fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("audit_logs")
}

model EmailDeliveryLog {
  id              String              @id @default(cuid())
  recipient       String
  recipients      String[]            @default([])
  subject         String
  category        String?
  status          EmailDeliveryStatus
  resendMessageId String?             @map("resend_message_id")
  resendData      Json?               @map("resend_data")
  resendError     Json?               @map("resend_error")
  errorMessage    String?             @map("error_message") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([recipient, createdAt])
  @@map("email_delivery_logs")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

// ============================================
// INVENTORY
// ============================================

model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  category     String
  brand        String?
  sku          String?  @unique
  unit         String
  stockLevel   Float    @default(0) @map("stock_level")
  reorderLevel Float    @map("reorder_level")
  reorderQty   Float    @map("reorder_qty")
  supplier     String?
  supplierRef  String?  @map("supplier_ref")
  costPrice    Float?   @map("cost_price")
  sellPrice    Float?   @map("sell_price")
  location     String?
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  movements    InventoryMovement[]
  invoiceLines InvoiceLine[]
  quoteLines   QuoteLine[]

  @@index([category])
  @@map("inventory_items")
}

model InventoryMovement {
  id         String   @id @default(cuid())
  itemId     String   @map("item_id")
  type       String   // in | out | adjustment
  quantity   Float
  reference  String?
  notes      String?
  recordedBy String?  @map("recorded_by")
  recordedAt DateTime @default(now()) @map("recorded_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("inventory_movements")
}

// ============================================
// INVOICING
// ============================================

model Invoice {
  id         String        @id @default(cuid())
  invoiceRef String        @unique @map("invoice_ref")
  customerId String        @map("customer_id")
  jobId      String?       @map("job_id")
  status     InvoiceStatus @default(draft)
  issueDate  String        @map("issue_date")
  dueDate    String        @map("due_date")
  subtotal   Float         @default(0)
  taxRate    Float         @default(15) @map("tax_rate")
  tax        Float         @default(0)
  total      Float         @default(0)
  notes      String?
  paidAt     DateTime?     @map("paid_at")
  paidRef    String?       @map("paid_ref")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  customer  Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job       Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems InvoiceLine[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @map("unit_price")
  total       Float
  itemId      String? @map("item_id")

  invoice Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Quote {
  id         String      @id @default(cuid())
  quoteRef   String      @unique @map("quote_ref")
  customerId String      @map("customer_id")
  status     QuoteStatus @default(draft)
  issueDate  String      @map("issue_date")
  validUntil String      @map("valid_until")
  subtotal   Float       @default(0)
  taxRate    Float       @default(15) @map("tax_rate")
  tax        Float       @default(0)
  total      Float       @default(0)
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lineItems QuoteLine[]

  @@index([customerId])
  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String  @map("quote_id")
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @map("unit_price")
  total       Float
  itemId      String? @map("item_id")

  quote Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item  InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_lines")
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// COMPANY PROFILE (Settings for PDFs & branding)
// ============================================

model CompanyProfile {
  id        String   @id @default("default")
  name      String   @default("Splash Air Conditioning")
  address   String   @default("661 Lorraine Drive, Bluffhill, Harare")
  phone     String   @default("0715212141 / 0773034528")
  email     String?  @default("info@splashaircrmzw.site")
  website   String?  @default("https://splashaircrmzw.site")
  vatRate   Float    @default(15.5)
  vatNumber String?  @map("vat_number")
  logoUrl   String?  @map("logo_url")
  tagline   String?  @default("Air Conditioning & Refrigeration Specialists")
  services  String?  @default("Installation, Maintenance, Repairs, Sales")
  onboarded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

	@@map("company_profile")
}

// ============================================
// FUND MANAGEMENT
// ============================================

enum FundStatus {
  active
  exhausted
  closed
}

model FundAllocation {
  id          String        @id @default(cuid())
  name        String?
  amount      Float
  spent       Float         @default(0)
  status      FundStatus    @default(active)
  notes       String?
  techId      String        @map("tech_id")
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tech      User          @relation("FundsAllocatedTo", fields: [techId], references: [id])
  createdBy User          @relation("FundsCreatedBy", fields: [createdById], references: [id])
  expenses  FundExpense[]

  @@map("fund_allocations")
}

model FundExpense {
  id             String   @id @default(cuid())
  fundId         String   @map("fund_id")
  jobId          String?  @map("job_id")
  description    String
  amount         Float
  receiptRef     String?  @map("receipt_ref")
  receiptDataUrl String?  @map("receipt_data_url") @db.Text
  notes          String?
  recordedById   String   @map("recorded_by_id")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  fund       FundAllocation @relation(fields: [fundId], references: [id], onDelete: Cascade)
  job        Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  recordedBy User           @relation("FundExpenseRecordedBy", fields: [recordedById], references: [id])

  @@index([fundId])
  @@index([jobId])
  @@map("fund_expenses")
}
